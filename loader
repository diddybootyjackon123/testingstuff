local dismissed = false
local destroyed = false
local displayed = 0
local target = 0
local connections = {}

local function fit()
    if not Scale then
        return
    end
    local camera = workspace and workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
    if viewport.X <= 0 or viewport.Y <= 0 then
        return
    end
    local ratio = math.min(viewport.X / 520, viewport.Y / 300)
    Scale.Scale = math.clamp(ratio, 0.5, 1)
end

pcall(fit)

pcall(function()
    local camera = workspace.CurrentCamera
    if camera then
        table.insert(connections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit))
    end
    table.insert(connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        pcall(fit)
    end))
end)

local keyGui = nil

local function cleanup()
    if destroyed then
        return
    end
    destroyed = true
    dismissed = true
    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    pcall(function()
        Loader:Destroy()
    end)
    if keyGui then
        pcall(function()
            keyGui:Destroy()
        end)
    end
    env.__NEOX_LOADER_ACTIVE = nil
end

task.delay(CONFIG.HARD_TIMEOUT, cleanup)

local function reveal(shown)
    for _, entry in ipairs(REVEAL) do
        local goal = {}
        goal[entry.Property] = shown and entry.Shown or 1
        local info = TweenInfo.new(
            shown and 0.4 or 0.28,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out,
            0,
            false,
            shown and entry.Order * 0.045 or 0
        )
        tween(entry.Object, info, goal)
    end
end

local function setTone(color)
    tween(Fill, TweenInfo.new(0.3), { BackgroundColor3 = color })
    tween(Dot, TweenInfo.new(0.3), { BackgroundColor3 = color })
end

local function setStatus(text)
    if dismissed or not Status or Status.Text == text then
        return
    end
    tween(Status, TweenInfo.new(0.12), { TextTransparency = 1 })
    task.delay(0.13, function()
        if dismissed then
            return
        end
        set(Status, "Text", text)
        tween(Status, TweenInfo.new(0.2), { TextTransparency = 0 })
    end)
end

local function setProgress(value)
    target = math.clamp(value, 0, 100)
end

task.spawn(function()
    while not dismissed and Sweep and Sweep.Parent do
        set(Sweep, "Offset", Vector2.new(-1, 0))
        tween(
            Sweep,
            TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { Offset = Vector2.new(1, 0) }
        )
        task.wait(2.4)
    end
end)

local stepSignal = RunService and (RunService.RenderStepped or RunService.Heartbeat)
local counter

if stepSignal then
    local ok, connection = pcall(function()
        return stepSignal:Connect(function(delta)
            if destroyed then
                return
            end
            displayed = displayed + (target - displayed) * math.min((delta or 0.016) * 7, 1)
            if math.abs(target - displayed) < 0.15 then
                displayed = target
            end
            set(Fill, "Size", UDim2.new(displayed / 100, 0, 1, 0))
            set(Percent, "Text", string.format("%02d", math.floor(displayed + 0.5)))
        end)
    end)
    if ok and connection then
        counter = connection
        table.insert(connections, connection)
    end
end

if not counter then
    task.spawn(function()
        while not destroyed do
            displayed = displayed + (target - displayed) * 0.2
            if math.abs(target - displayed) < 0.15 then
                displayed = target
            end
            set(Fill, "Size", UDim2.new(displayed / 100, 0, 1, 0))
            set(Percent, "Text", string.format("%02d", math.floor(displayed + 0.5)))
            task.wait(0.03)
        end
    end)
end

local function showLoader()
    reveal(true)
    tween(
        Panel,
        TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Position = UDim2.new(0.5, 0, 0.5, 0) }
    )
    task.wait(0.45)
end

local function hideLoader()
    if dismissed then
        return
    end
    dismissed = true
    reveal(false)
    tween(
        Panel,
        TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        { Position = UDim2.new(0.5, 0, 0.5, 10) }
    )
    task.wait(0.45)
    pcall(function()
        Loader:Destroy()
    end)
end

