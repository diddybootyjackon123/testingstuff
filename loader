local function showStatus(text, color, duration, showLoading, helpText)
    if currentStatusThread then
        pcall(task.cancel, currentStatusThread)
        currentStatusThread = nil
    end

    statusLabel.Text = text
    statusLabel.TextColor3 = color or KEYCOLOR.INFO
    loadingDots.Visible = showLoading or false

    if helpText then
        helpLabel.Text = helpText
        helpLabel.Visible = true
    else
        helpLabel.Visible = false
    end

    if showLoading then
        task.spawn(function()
            local dots = 0
            while loadingDots.Visible do
                dots = (dots % 3) + 1
                loadingDots.Text = strRep('.', dots)
                task.wait(0.5)
            end
        end)
    end

    if duration then
        currentStatusThread = task.spawn(function()
            task.wait(duration)
            statusLabel.Text = ''
            loadingDots.Visible = false
            helpLabel.Visible = false
        end)
    end
end

