local function mount(gui)
    pcall(function()
        if syn and syn.protect_gui then
            syn.protect_gui(gui)
        elseif protect_gui then
            protect_gui(gui)
        end
    end)

    local targets = {}

    if gethui then
        table.insert(targets, function()
            return gethui()
        end)
    end

    table.insert(targets, function()
        return service("CoreGui")
    end)

    table.insert(targets, function()
        local player = Players and Players.LocalPlayer
        return player and player:FindFirstChildOfClass("PlayerGui")
    end)

    for _, resolve in ipairs(targets) do
        local ok, container = pcall(resolve)
        if ok and container then
            local mounted = pcall(function()
                gui.Parent = container
            end)
            if mounted and gui.Parent then
                return true
            end
        end
    end

    return false
end

local function httpGet(url)
    for attempt = 1, CONFIG.HTTP_ATTEMPTS do
        local ok, body = pcall(function()
            return game:HttpGet(url, true)
        end)
        if ok and type(body) == "string" and #body > 0 then
            return body
        end

        local sent, response = pcall(function()
            return requestFunc({ Url = url, Method = "GET" })
        end)
        if sent and type(response) == "table" then
            local payload = response.Body or response.body
            if type(payload) == "string" and #payload > 0 then
                return payload
            end
        end

        if attempt < CONFIG.HTTP_ATTEMPTS then
            task.wait(0.5 * attempt)
        end
    end
    return nil
end

local compile = loadstring or load

local function runSource(source, chunkName)
    if type(source) ~= "string" or not compile then
        return false, "no compiler available"
    end
    local compiled, chunk = pcall(compile, source, chunkName)
    if not compiled then
        return false, "compile crashed: " .. tostring(chunk)
    end
    if type(chunk) ~= "function" then
        return false, "syntax error: " .. tostring(chunk)
    end
    local ran, err = pcall(chunk)
    if not ran then
        return false, "runtime error: " .. tostring(err)
    end
    return true, nil
end

