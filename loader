local function getNonce()
    local success, response = pcall(function()
        return requestFunc({
            Url = CONFIG.BASE_URL .. '/api/get-nonce',
            Method = 'GET',
            Headers = { ['Content-Type'] = 'application/json' },
        })
    end)

    if not success or not response or not response.Body then
        return nil, 'Failed to retrieve security handshake (ERR-HS02)'
    end

    local decodeSuccess, body = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodeSuccess or not body or not body.nonce then
        return nil, 'Invalid server handshake response (ERR-HS03)'
    end

    return body.nonce, nil
end

local isProcessing = false

local function validateKey(key)
    if key == '' or key:match('^%s*$') then
        showStatus('Key field is empty', KEYCOLOR.WARNING, 2)
        return nil
    end

    showStatus('Fetching security handshake...', KEYCOLOR.INFO, nil, true)
    task.wait(0.5)

    local nonce, nonceError = getNonce()
    if not nonce then
        showStatus(nonceError or 'Failed to initiate security handshake (ERR-HS01)', KEYCOLOR.ERROR, 3, false,
            "Help: Check your internet connection, disable VPN if using one, and try again.")
        return nil
    end

    showStatus('Connecting to server...', KEYCOLOR.INFO, nil, true)
    task.wait(0.5)

    local success, response = pcall(function()
        return requestFunc({
            Url = CONFIG.BASE_URL .. '/api/validate-key',
            Method = 'POST',
            Headers = { ['Content-Type'] = 'application/json' },
            Body = HttpService:JSONEncode({
                key = key,
                hwid = hwid,
                nonce = nonce,
                game_name = gameName,
            }),
        })
    end)

    if not success then
        showStatus('Connection failed - Network error', KEYCOLOR.ERROR, 3, false,
            "Help: Your executor might be struggling to send the request. Check internet connection and try again.")
        return nil
    end

    if not response then
        showStatus('No response from server', KEYCOLOR.ERROR, 3, false,
            "Help: Server might be down or your internet is slow. Try again later.")
        return nil
    end

    showStatus('Processing server response...', KEYCOLOR.INFO, nil, true)
    task.wait(0.3)

    if not response.Body then
        showStatus('Server returned empty response', KEYCOLOR.ERROR, 3, false,
            "Help: Your executor might be struggling to receive data. Check internet stability.")
        return nil
    end

    local decodeSuccess, body = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodeSuccess or type(body) ~= 'table' then
        showStatus('Failed to decode server response', KEYCOLOR.ERROR, 3, false,
            "Help: Internet problem or server issue. Try again with better connection.")
        return nil
    end

    if not body.valid then
        if body.reason then
            local reason = string.lower(tostring(body.reason))
            if string.find(reason, 'nonce') then
                showStatus('Invalid or expired nonce', KEYCOLOR.ERROR, 3, false,
                    "Help: Security handshake failed. Disable VPN and try again.")
            elseif string.find(reason, 'hwid blacklist') then
                showStatus('Your HWID Is Blocked (contact us)', KEYCOLOR.ERROR, 3, false,
                    "Help: Contact support in Discord for assistance.")
            elseif string.find(reason, 'hwid') or string.find(reason, 'hardware') then
                showStatus('Key bound to another HWID', KEYCOLOR.ERROR, 3, false,
                    "Help: This key is already used on different device. Get a new key.")
            else
                showStatus('Key validation failed: ' .. tostring(body.reason), KEYCOLOR.ERROR, 3, false,
                    "Help: Check if key is correct and not expired. Get a new key if needed.")
            end
        else
            showStatus('Key is invalid or expired', KEYCOLOR.ERROR, 3, false,
                "Help: Key might be expired or incorrect. Get a new key from our website.")
        end
        return nil
    end

    if type(body.unlock) ~= 'string' or #body.unlock ~= 64 then
        showStatus('Authorization rejected (ERR-AU01)', KEYCOLOR.ERROR, 4, false,
            "Help: Your executor environment is modified or the response was tampered with. Close other scripts and retry.")
        return nil
    end

    return { unlock = body.unlock, nonce = nonce, key = key }
end

local dbgLines = {}
local function dbg(msg)
    local line = '[NEOX] ' .. tostring(msg)
    dbgLines[#dbgLines + 1] = line
    pcall(function() warn(line) end)
    pcall(function() print(line) end)
    pcall(function()
        if writefile then
            writefile('neox_debug.txt', tblConcat(dbgLines, '\n'))
        end
    end)
    pcall(function()
        statusLabel.Text = tostring(msg)
    end)
end

local function decryptAndRun(auth)
    dbg('STAGE 1: starting unlock')
    local unlockBytes = hexToBytes(auth.unlock)
    if not unlockBytes or #unlockBytes ~= 32 then
        dbg('STAGE 1 FAILED: unlock bytes = ' .. tostring(unlockBytes and #unlockBytes or 'nil'))
        return false, 'Authorization rejected (ERR-AU02)'
    end
    dbg('STAGE 1 OK: unlock is 32 bytes')

    dbg('STAGE 2: building key')
    local mask = sha256Bytes(auth.nonce .. '|' .. hwid .. '|' .. auth.key)
    local scriptKey = xorStrings(unlockBytes, mask)
    if #scriptKey ~= 32 then
        dbg('STAGE 2 FAILED: key length ' .. tostring(#scriptKey))
        return false, 'Authorization rejected (ERR-AU03)'
    end
    dbg('STAGE 2 OK: key built')

    showStatus('Downloading script...', KEYCOLOR.INFO, nil, true)
    dbg('STAGE 3: downloading ' .. tostring(gameURL))
    local blob = httpGet(gameURL)
    if not blob or #blob < 32 then
        dbg('STAGE 3 FAILED: got ' .. tostring(blob and #blob or 'nil') .. ' bytes')
        return false, 'Failed to download script (ERR-PL01)'
    end
    dbg('STAGE 3 OK: downloaded ' .. #blob .. ' bytes')

    showStatus('Decrypting script...', KEYCOLOR.INFO, nil, true)

    local marker = 'NX7F2A'
    local dataStart = string.find(blob, marker, 1, true)
    if dataStart then
        local dataEnd = string.find(blob, marker, dataStart + #marker, true)
        if dataEnd then
            blob = strSub(blob, dataStart + #marker, dataEnd - 1)
            dbg('STAGE 4 OK: marker found, data is ' .. #blob .. ' bytes')
        else
            dbg('STAGE 4 WARNING: opening marker found but no closing marker')
        end
    else
        dbg('STAGE 4 WARNING: no marker found, using whole file')
    end

    dbg('STAGE 5: base64 decoding')
    local raw = base64Decode(blob)
    if not raw or #raw < 24 then
        dbg('STAGE 5 FAILED: decoded ' .. tostring(raw and #raw or 'nil') .. ' bytes')
        return false, 'Corrupt script data (ERR-PL02)'
    end
    dbg('STAGE 5 OK: decoded to ' .. #raw .. ' bytes')

    dbg('STAGE 6: decrypting (this can take a few seconds)')
    local plain = rc4(raw, scriptKey, 768)
    dbg('STAGE 6 OK: decrypted ' .. #plain .. ' bytes, header = "' .. strSub(plain, 1, 7) .. '"')

    if strSub(plain, 1, 7) ~= 'NEOXP1|' or strSub(plain, 16, 16) ~= '|' then
        dbg('STAGE 7 FAILED: wrong header - file not encrypted, or wrong secret')
        return false, 'Authorization rejected (ERR-AU04)'
    end
    dbg('STAGE 7 OK: header valid')

    local checksum = strSub(plain, 8, 15)
    dbg('STAGE 7b: checksum field read = ' .. tostring(checksum))
    local source = strSub(plain, 17)
    dbg('STAGE 7c: source extracted, ' .. tostring(#source) .. ' bytes')
    dbg('STAGE 7d: source starts with: ' .. strSub(source, 1, 60))

    if #source < 16 then
        dbg('STAGE 8 FAILED: source only ' .. #source .. ' bytes')
        return false, 'Script data incomplete (ERR-PL03)'
    end

    dbg('STAGE 8: verifying checksum')
    local actual = fnv1aHex(source)
    dbg('STAGE 8b: computed ' .. tostring(actual) .. ' expected ' .. tostring(checksum))
    if actual ~= checksum then
        dbg('STAGE 8 FAILED: checksum mismatch')
        return false, 'Script integrity check failed (ERR-IN01)'
    end
    dbg('STAGE 8 OK: checksum matches')

    showStatus('Loading ' .. gameName .. '...', KEYCOLOR.SUCCESS, nil, true)
    dbg('STAGE 9: compiling')
    local compiledOk, chunk = pcall(compile, source)
    dbg('STAGE 9b: compile returned ok=' .. tostring(compiledOk) .. ' type=' .. type(chunk))
    if not compiledOk then
        dbg('STAGE 9 FAILED: compile crashed: ' .. tostring(chunk))
        return false, 'Compile crashed: ' .. tostring(chunk)
    end
    if type(chunk) ~= 'function' then
        dbg('STAGE 9 FAILED: syntax error: ' .. tostring(chunk))
        return false, 'Syntax error: ' .. tostring(chunk)
    end

    dbg('STAGE 10: running your script now')
    local ranOk, runErr = pcall(chunk)
    if not ranOk then
        dbg('STAGE 10 FAILED: ' .. tostring(runErr))
        return false, 'Script error: ' .. tostring(runErr)
    end
    dbg('STAGE 10 OK: script finished')
    return true, nil
end

local function runGameScript(auth)
    local ok, result, err = pcall(decryptAndRun, auth)
    if not ok then
        dbg('CRASH: ' .. tostring(result))
        return false, 'Loader error: ' .. tostring(result)
    end
    return result, err
end

local function handleVerification()
    if isProcessing then return end

    local key = keyInput.Text
    isProcessing = true
    setInputVisible(false)

    showStatus('Starting key verification process...', KEYCOLOR.INFO, nil, true)
    task.wait(1)

    local auth = validateKey(key)
    if auth then
        showStatus('Key verification successful', KEYCOLOR.SUCCESS, 1)
        task.wait(1)

        if writefile and saveKey(key) then
            showStatus('Key saved for future use', KEYCOLOR.SUCCESS, 1)
            task.wait(1)
        end

        local ok, err = runGameScript(auth)
        if ok then
            cleanup()
            return
        end

        showStatus(err or 'Failed to load script', KEYCOLOR.ERROR, 5, false,
            "Help: If this keeps happening, rejoin without any other scripts running and try again.")
        sendNotification(CONFIG.HUB_NAME .. " - ERROR", err or 'Failed to load script', CONFIG.NOTIFICATION_DURATION.ERROR)
        isProcessing = false
        task.wait(5)
        setInputVisible(true)
    else
        isProcessing = false
        task.wait(3)
        setInputVisible(true)
    end
end

