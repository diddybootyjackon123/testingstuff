local function new(class, props)
    local created, inst = pcall(Instance.new, class)
    if not created or not inst then
        return nil
    end
    local parent = props.Parent
    props.Parent = nil
    for key, value in pairs(props) do
        pcall(function()
            inst[key] = value
        end)
    end
    if parent then
        pcall(function()
            inst.Parent = parent
        end)
    end
    return inst
end

